rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /deals/{businessId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == businessId &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == businessId;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
