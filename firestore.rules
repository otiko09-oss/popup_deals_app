rules_version = '2';

// Popup Deals — Firestore security rules.
// Deploy with: firebase deploy --only firestore:rules
//
// IMPORTANT — business ownership model:
// businesses/{businessId} — the document ID *is* the owner's Firebase Auth
// uid (see business_onboarding_page.dart: 'id': firebaseUser.uid). There is
// no separate ownerUid field. So "is this caller the owner" is just
// `businessId == request.auth.uid`, and for deals/orders/redemptions,
// businessId/restaurantId fields hold that same value.
//
// business_staff/{staffUid} — one doc per staff member, doc ID is the
// staff member's own uid. Fields: businessId, isActive, createdAt. Only the
// business owner (or an admin) can create/update/delete these; a staff
// member with isActive:true can act on behalf of that business for
// order/deal/redemption updates (e.g. scanning QR codes), but cannot touch
// business-level settings, subscriptions, or moderation.
//
// Design notes:
//  - "deals" are publicly readable (it's a discovery app) but writes are
//    restricted to the owning business (or its active staff), and
//    moderationStatus/isActive can only be flipped server-side
//    (Cloud Functions / admin), not by clients. New deals can only be
//    created by an approved business.
//  - "subscriptions" are written only by the Cloud Functions backend
//    (Stripe webhook uses the Admin SDK, which bypasses these rules) —
//    clients get read-only access to their own business's subscription.
//  - "redemptions" are created at claim time; only the business owner/staff
//    performing the scan may update status/redeemedAt — every other field
//    is immutable after creation. Never deletable by clients.
//  - Admin access is granted via the isAdmin field on the caller's own
//    users/{uid} document. That field can only ever be set to true by
//    another admin (see the users/{userId} rules below) — a user can
//    never set isAdmin (or isBlocked) on their own document.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isApprovedBusiness(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)).data.status == 'approved';
    }

    // True if the caller is an active staff member of the given business.
    function isStaffOf(businessId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/business_staff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/business_staff/$(request.auth.uid)).data.businessId == businessId &&
        get(/databases/$(database)/documents/business_staff/$(request.auth.uid)).data.isActive == true;
    }

    // True if the caller is the owner OR an active staff member of businessId.
    function canActFor(businessId) {
      return isOwner(businessId) || isStaffOf(businessId);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        (('isAdmin' in request.resource.data) == false || request.resource.data.isAdmin == false) &&
        (('isBlocked' in request.resource.data) == false || request.resource.data.isBlocked == false);
      allow update: if isOwner(userId) &&
        !('isBlocked' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('isAdmin' in request.resource.data.diff(resource.data).affectedKeys());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /businesses/{businessId} {
      allow read: if true;
      // The business doc ID IS the owner's uid — no separate ownerUid field.
      allow create: if isOwner(businessId) &&
        (('status' in request.resource.data) == false ||
          request.resource.data.status == 'pending');
      allow update: if (isOwner(businessId) &&
        !('status' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('subscriptionPlanId' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('subscriptionStatus' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('maxActiveDeals' in request.resource.data.diff(resource.data).affectedKeys())
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Only the business owner manages who their staff is.
    match /business_staff/{staffUid} {
      allow read: if isOwner(staffUid) ||
        (isSignedIn() && isOwner(resource.data.businessId)) ||
        isAdmin();
      allow create: if isSignedIn() &&
        isOwner(request.resource.data.businessId) &&
        request.resource.data.businessId != staffUid; // owner can't add self as staff
      allow update: if isSignedIn() && isOwner(resource.data.businessId) &&
        !('businessId' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if isSignedIn() && isOwner(resource.data.businessId) || isAdmin();
    }

    match /deals/{dealId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.restaurantId != null &&
        canActFor(request.resource.data.restaurantId) &&
        isApprovedBusiness(request.resource.data.restaurantId) &&
        request.resource.data.moderationStatus == 'pending';
      allow update: if (isSignedIn() &&
        canActFor(resource.data.restaurantId) &&
        !('moderationStatus' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('isActive' in request.resource.data.diff(resource.data).affectedKeys())
      ) || isAdmin();
      allow delete: if isAdmin() ||
        (isSignedIn() && isOwner(resource.data.restaurantId));
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid ||
         canActFor(resource.data.businessId) ||
         isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // The customer can update their own order (e.g. cancel); the
      // business or its staff can update it too (e.g. mark completed on
      // redemption) — but neither side can reassign who it belongs to.
      allow update: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || canActFor(resource.data.businessId)) &&
        !('userId' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('businessId' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if isAdmin();
    }

    match /redemptions/{redemptionId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid ||
         canActFor(resource.data.businessId) ||
         isAdmin());
      allow create: if isSignedIn();
      // Only the business (owner or active staff) performing the scan may
      // update a redemption, and only to flip its status/redeemedAt —
      // every identifying field is locked after creation.
      allow update: if isSignedIn() &&
        canActFor(resource.data.businessId) &&
        !('userId' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('businessId' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('dealId' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('orderId' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if false;
    }

    match /subscriptions/{businessId} {
      allow read: if isSignedIn() &&
        (isOwner(businessId) || isAdmin());
      // Self-service exception: the owner may create their own initial
      // 30-day trial, and may cancel it (status + expiresAt only) —
      // everything else (activation, plan changes, billing fields) is
      // written only by the Cloud Functions Stripe webhook (Admin SDK).
      allow create: if isOwner(businessId) &&
        request.resource.data.status == 'trial' &&
        request.resource.data.businessId == businessId;
      allow update: if isOwner(businessId) &&
        resource.data.status == 'trial' &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'expiresAt']);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}