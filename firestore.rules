rules_version = '2';

// Popup Deals — Firestore security rules.
// Deploy with: firebase deploy --only firestore:rules
//
// Design notes:
//  - "businesses" write access is limited to the business owner (ownerUid field).
//  - "deals" are publicly readable (it's a discovery app) but writes are
//    restricted to the owning business, and moderationStatus/isActive can
//    only be flipped server-side (Cloud Functions / admin), not by clients.
//  - "subscriptions" are written only by the Cloud Functions backend
//    (Stripe webhook uses the Admin SDK, which bypasses these rules) —
//    clients get read-only access to their own business's subscription.
//  - "redemptions" are created at redemption time and immutable afterward.
//  - Admin access is gated on a custom claim `admin: true` set via Cloud
//    Functions — there is no client-writable "isAdmin" flag anywhere.

function isSignedIn() {
  return request.auth != null;
}

function isOwner(uid) {
  return isSignedIn() && request.auth.uid == uid;
}

function isAdmin() {
  return isSignedIn() && request.auth.token.admin == true;
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) &&
        !('isBlocked' in request.resource.data.diff(resource.data).affectedKeys());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.ownerUid == request.auth.uid &&
        !('isVerified' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('subscriptionPlanId' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('subscriptionStatus' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('maxActiveDeals' in request.resource.data.diff(resource.data).affectedKeys())
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    match /deals/{dealId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.restaurantId != null &&
        get(/databases/$(database)/documents/businesses/$(request.resource.data.restaurantId)).data.ownerUid == request.auth.uid &&
        request.resource.data.moderationStatus == 'pending';
      allow update: if (isSignedIn() &&
        get(/databases/$(database)/documents/businesses/$(resource.data.restaurantId)).data.ownerUid == request.auth.uid &&
        !('moderationStatus' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('isActive' in request.resource.data.diff(resource.data).affectedKeys())
      ) || isAdmin();
      allow delete: if isAdmin() ||
        (isSignedIn() && get(/databases/$(database)/documents/businesses/$(resource.data.restaurantId)).data.ownerUid == request.auth.uid);
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /redemptions/{redemptionId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.businessId == request.auth.uid ||
         isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /subscriptions/{businessId} {
      allow read: if isSignedIn() &&
        (get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
